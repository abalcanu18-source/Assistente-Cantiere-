# Copia questo file in ".env" e compila i valori reali.
# Il file ".env" NON va mai condiviso o caricato online: contiene le tue chiavi segrete.

# Il server usa l'ora italiana per le sveglie 6:30 / 17:00 / 17:30
TZ=Europe/Rome


# Password per accedere al pannello di amministrazione (operai, mezzi, cantieri, impostazioni)
ADMIN_PASSWORD=cambiami123

# Chiave API di OpenAI (https://platform.openai.com/api-keys) - serve per l'assistente vocale "intelligente"
OPENAI_API_KEY=sk-...

# Modello OpenAI da usare per interpretare le risposte vocali
OPENAI_MODEL=gpt-4o-mini

# --- Invio Email (rapportino PDF alla segreteria) ---
# Esempio con Gmail: usa una "Password per le app" (non la password normale del tuo account Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tuoindirizzo@gmail.com
SMTP_PASS=password_app_generata
SMTP_FROM="Assistente Cantieri <tuoindirizzo@gmail.com>"
SECRETARY_EMAIL=segreteria@tuaazienda.it

# --- Notifiche push (sveglia mattina/sera) ---
# Genera queste due chiavi con: npm run generate-vapid (dentro la cartella backend)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:info@tuaazienda.it

# Indirizzo del frontend, usato nelle policy CORS
FRONTEND_ORIGIN=http://localhost:5173

# --- Database cloud (necessario solo quando l'app è online, es. su Render) ---
# In locale puoi lasciare questi due vuoti: l'app userà automaticamente un
# file nella cartella backend/data. Online invece il disco viene cancellato
# ad ogni riavvio, quindi serve un database gratuito che sopravviva: crea un
# database Redis gratuito su https://console.upstash.com e incolla qui
# "UPSTASH_REDIS_REST_URL" e "UPSTASH_REDIS_REST_TOKEN" (li trovi nella
# scheda "REST API" del tuo database).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
